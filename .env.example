# Copy to .env and fill in. See docs/DEPLOYMENT.md in the expenso repo.

# --- OpenAI (one key for the whole product; cap it on the OpenAI dashboard) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frappe (authorization server + system of record) ---
FRAPPE_URL=http://host.docker.internal:8000
FRAPPE_OAUTH_CLIENT_ID=
FRAPPE_OAUTH_CLIENT_SECRET=

# This service's public hostname — the single source of truth. Used bare by
# nginx's Traefik router label, and with an https:// prefix docker-compose.yml
# derives PUBLIC_BASE_URL (OAuth proxy callbacks) from it for the `app`
# service's environment. Not read directly by the app itself.
ASSISTANT_HOSTNAME=expenso-assistant.22logic.com

# --- FastMCP external-connector adapter ---
MCP_ENABLED=true

# --- In-app Assistant tab (P6-S6) ---
# Comma-separated browser origins allowed to call the service (the Frappe app's
# public origin — expenso is installed on the shared 22logic.com site, not its
# own subdomain). Empty in dev if the frontend is not browser-driven.
ALLOWED_CORS_ORIGINS=https://22logic.com

# --- Langfuse v2 (self-hosted, loopback only) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- Postgres (checkpointer + Langfuse share the instance) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/assistant

# --- Agent run bounds ---
# "Today" for the daily caps and the agent's date reasoning (the Family's tz).
SERVICE_TIMEZONE=Asia/Kolkata
# Per-run runaway guard. RUN_RECURSION_LIMIT sits above 2 x RUN_MAX_TOOL_CALLS
# so the tool-call cap is the one that bites first.
RUN_RECURSION_LIMIT=50
RUN_MAX_TOOL_CALLS=20
RUN_WALL_CLOCK_SECONDS=90

# --- Per-Member daily token cap (input+output, counted from a local Postgres
# total — no fail-open; ADR 0008's 2026-09-11 update replaced the old
# turn-count DAILY_CHAT_CAP with this) ---
DAILY_TOKEN_CAP=500000

# How much of a thread's persisted history is resent to the model per turn —
# bounds tokens, not message count. A transient trim; the checkpointed
# thread itself is never pruned.
CHAT_HISTORY_TOKEN_BUDGET=20000

# Secondary bound alongside the daily token cap: rejects an oversized single
# message with a 413.
MAX_CHAT_MESSAGE_CHARS=4000

# --- Confirm-card batch cap (P6-S7) ---
# At most this many proposed writes per confirm card; the agent offers to
# continue with the rest. Replaced the daily write cap.
MAX_PROPOSED_WRITES_PER_TURN=25
