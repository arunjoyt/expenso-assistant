# Copy to .env and fill in. See docs/DEPLOYMENT.md in the expenso repo.

# --- OpenAI (one key for the whole product; cap it on the OpenAI dashboard) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frappe (authorization server + system of record) ---
FRAPPE_URL=http://host.docker.internal:8000
FRAPPE_OAUTH_CLIENT_ID=
FRAPPE_OAUTH_CLIENT_SECRET=

# This service's own public URL (OAuth proxy callbacks).
PUBLIC_BASE_URL=https://assistant.example.com

# --- FastMCP external-connector adapter ---
MCP_ENABLED=true

# --- In-app Assistant tab (P6-S6) ---
# Comma-separated browser origins allowed to call the service (the Frappe app's
# public origin). Empty in dev if the frontend is not browser-driven.
ALLOWED_CORS_ORIGINS=https://expenso.example.com

# --- Langfuse v2 (self-hosted, loopback only) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- Postgres (checkpointer + Langfuse share the instance) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/assistant

# --- Agent run bounds ---
# "Today" for the daily caps and the agent's date reasoning (the Family's tz).
SERVICE_TIMEZONE=Asia/Kolkata
# Per-run runaway guard. RUN_RECURSION_LIMIT sits above 2 x RUN_MAX_TOOL_CALLS
# so the tool-call cap is the one that bites first.
RUN_RECURSION_LIMIT=50
RUN_MAX_TOOL_CALLS=20
RUN_WALL_CLOCK_SECONDS=90

# --- Per-Member daily chat cap (counted from Langfuse, fail-open) ---
DAILY_CHAT_CAP=50

# --- Confirm-card batch cap (P6-S7) ---
# At most this many proposed writes per confirm card; the agent offers to
# continue with the rest. Replaced the daily write cap.
MAX_PROPOSED_WRITES_PER_TURN=25
